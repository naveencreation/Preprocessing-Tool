    pip install pandas scikit-learn
"""

import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, MinMaxScaler

# =============================================================================
# Load Data
# =============================================================================

df = pd.read_csv("input.csv")
print(f"Loaded {len(df)} rows, {len(df.columns)} columns")

{% for step in steps %}
# =============================================================================
# Step {{ loop.index }}: {{ step.type | replace('_', ' ') | title }}
# =============================================================================

{% if step.type == "type_casting" %}
{% for op in step.operations %}
df["{{ op.column }}"] = df["{{ op.column }}"].astype("{{ op.to }}")
{% endfor %}
print("Type casting complete")

{% elif step.type == "cleaning" %}
{% if step.remove_duplicates %}
# Remove duplicate rows
df = df.drop_duplicates()
{% endif %}
{% for mv in step.missing_values %}
{% if mv.strategy == "drop" %}
# Drop rows with missing values in '{{ mv.column }}'
df = df.dropna(subset=["{{ mv.column }}"])
{% elif mv.strategy == "mean" %}
# Fill missing values in '{{ mv.column }}' with mean
df["{{ mv.column }}"] = df["{{ mv.column }}"].fillna(df["{{ mv.column }}"].mean())
{% elif mv.strategy == "median" %}
# Fill missing values in '{{ mv.column }}' with median
df["{{ mv.column }}"] = df["{{ mv.column }}"].fillna(df["{{ mv.column }}"].median())
{% elif mv.strategy == "mode" %}
# Fill missing values in '{{ mv.column }}' with mode
df["{{ mv.column }}"] = df["{{ mv.column }}"].fillna(df["{{ mv.column }}"].mode().iloc[0])
{% endif %}
{% endfor %}
print(f"Cleaning complete: {len(df)} rows remaining")

{% elif step.type == "outliers" %}
{% for col in step.columns %}
# Treat outliers in '{{ col }}' using {{ step.method | upper }} method
{% if step.method == "iqr" %}
Q1_{{ loop.index }} = df["{{ col }}"].quantile(0.25)
Q3_{{ loop.index }} = df["{{ col }}"].quantile(0.75)
IQR_{{ loop.index }} = Q3_{{ loop.index }} - Q1_{{ loop.index }}
lower_{{ loop.index }} = Q1_{{ loop.index }} - {{ step.threshold }} * IQR_{{ loop.index }}
upper_{{ loop.index }} = Q3_{{ loop.index }} + {{ step.threshold }} * IQR_{{ loop.index }}
{% elif step.method == "zscore" %}
mean_{{ loop.index }} = df["{{ col }}"].mean()
std_{{ loop.index }} = df["{{ col }}"].std()
lower_{{ loop.index }} = mean_{{ loop.index }} - {{ step.threshold }} * std_{{ loop.index }}
upper_{{ loop.index }} = mean_{{ loop.index }} + {{ step.threshold }} * std_{{ loop.index }}
{% endif %}
{% if step.treatment == "cap" %}
df["{{ col }}"] = df["{{ col }}"].clip(lower=lower_{{ loop.index }}, upper=upper_{{ loop.index }})
{% elif step.treatment == "remove" %}
df = df[(df["{{ col }}"] >= lower_{{ loop.index }}) & (df["{{ col }}"] <= upper_{{ loop.index }})]
{% endif %}
{% endfor %}
print(f"Outlier treatment complete: {len(df)} rows remaining")

{% elif step.type == "transforms" %}
{% for s in step.scaling %}
# Scale '{{ s.column }}' using {{ s.method }} scaler
{% if s.method == "standard" %}
scaler_{{ loop.index }} = StandardScaler()
df["{{ s.column }}"] = scaler_{{ loop.index }}.fit_transform(df[["{{ s.column }}"]])
{% elif s.method == "minmax" %}
scaler_{{ loop.index }} = MinMaxScaler()
df["{{ s.column }}"] = scaler_{{ loop.index }}.fit_transform(df[["{{ s.column }}"]])
{% endif %}
{% endfor %}
{% for e in step.encoding %}
{% if e.method == "one_hot" %}
# One-hot encode '{{ e.column }}'
dummies = pd.get_dummies(df["{{ e.column }}"], prefix="{{ e.column }}")
df = pd.concat([df.drop(columns=["{{ e.column }}"]), dummies], axis=1)
{% endif %}
{% endfor %}
print(f"Transformations complete: {len(df.columns)} columns")

{% elif step.type == "split" %}
# Train/Test Split
train_df, test_df = train_test_split(
    df,
    test_size={{ step.test_size }},
    random_state={{ step.random_state }},
    shuffle={{ step.shuffle }}
)
print(f"Split complete: {len(train_df)} train, {len(test_df)} test")

{% endif %}
{% endfor %}
# =============================================================================
# Export Results
# =============================================================================

{% if has_split %}
train_df.to_csv("train_processed.csv", index=False)
test_df.to_csv("test_processed.csv", index=False)
print("Exported: train_processed.csv, test_processed.csv")
{% else %}
df.to_csv("processed.csv", index=False)
print("Exported: processed.csv")
{% endif %}

print("Pipeline complete!")
